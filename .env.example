# Canonical origin used for canonical URLs, sitemap, JSON-LD and social cards.
NEXT_PUBLIC_SITE_URL=https://browserailab.in

# Set to "true" only after browserailab.in serves this deployment over HTTPS.
# Then requests to LEGACY_HOSTS get a permanent (308) redirect to NEXT_PUBLIC_SITE_URL.
ENABLE_DOMAIN_REDIRECTS=false
LEGACY_HOSTS=browser-ai-lab.vercel.app,www.browserailab.in

# Search engine verification (optional; HTML-tag method). DNS verification needs no code.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (optional). Leave empty for no analytics at all.
# When set, nothing loads until the visitor accepts the consent banner.
NEXT_PUBLIC_GA_ID=
